---
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content="#10141a" />
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family: 'Schibsted Grotesk', sans-serif;
		scroll-behavior: smooth;
		color: #e3e9f0;
		background: #10141a;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		color-scheme: dark;
		--font-sans: 'Schibsted Grotesk', sans-serif;
		--muted: #8c9bab;
		--line: #293441;
		--surface: #151b22;
		--surface-raised: #1b2530;
		--text: #e3e9f0;
		--text-soft: #a3b0c0;
		--accent: #9fc9ff;
	}

	* { box-sizing: border-box; }
	body { margin: 0; min-width: 320px; }
	a { color: inherit; }
	::selection { color: #10151d; background: #9fc9ff; }
	::view-transition-group(root),
	::view-transition-old(root),
	::view-transition-new(root) { animation-duration: 120ms; }
	@media (prefers-reduced-motion: reduce) {
		:root { scroll-behavior: auto; }
	}
	.link-preview {
		position: fixed;
		z-index: 1000;
		width: min(380px, calc(100vw - 24px));
		max-height: min(360px, calc(100vh - 24px));
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		touch-action: pan-y;
		scrollbar-gutter: stable;
		padding: 18px 20px;
		border: 1px solid var(--line);
		border-radius: 7px;
		color: var(--text-soft);
		background: #151b22;
		box-shadow: 0 10px 30px rgb(0 0 0 / 35%);
		font-size: 14px;
		line-height: 1.6;
		pointer-events: auto;
	}
	.link-preview[hidden] { display: none; }
	.link-preview strong { display: block; margin-bottom: 8px; color: var(--text); font-size: 17px; }
	.link-preview :is(h1, h2, h3, h4, h5, h6) { margin: 0 0 8px; color: var(--text); font-size: 16px; line-height: 1.35; }
	.link-preview p { margin: 0 0 10px; }
	.link-preview p:last-child { margin-bottom: 0; }
	.link-preview a { color: var(--accent); text-decoration-color: #496785; text-underline-offset: 2px; }
	.link-preview ul, .link-preview ol { margin: 0 0 10px; padding-left: 20px; }
	.link-preview blockquote { margin: 8px 0; padding-left: 10px; border-left: 2px solid #5e83aa; color: var(--muted); }
	.link-preview code { padding: 1px 4px; border-radius: 3px; background: #202a36; font-family: ui-monospace, monospace; font-size: .9em; }
	.link-preview pre { overflow-x: auto; padding: 9px; border-radius: 4px; background: #202a36; }
	.link-preview pre code { padding: 0; }
</style>
