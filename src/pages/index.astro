---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';

const notes = (await getCollection('notes')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const allTags = [...new Set(notes.flatMap((note) => note.data.tags))].sort((a, b) => a.localeCompare(b));
const selectedTag = Astro.url.searchParams.get('tag');
const visibleNotes = selectedTag ? notes.filter((note) => note.data.tags.includes(selectedTag)) : notes;
---

<Layout title="Notes">
	<div class="home-page">
		<Sidebar allTags={allTags} selectedTag={selectedTag ?? undefined} />

		<main class="note-list">
			{visibleNotes.map((note) => (
				<a class="note-link" href={`/notes/${note.id.replace(/\.md$/, '')}/`}>
					<span>{note.data.title}</span>
					<span class="note-tags">{note.data.tags.map((tag) => `#${tag}`).join(', ')}</span>
				</a>
			))}
		</main>
	</div>
</Layout>

<style>
	.home-page { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
	.note-list { width: min(100%, 820px); margin: 0 auto; padding: 24px 32px; }
	.note-link { display: flex; justify-content: space-between; gap: 24px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
	.note-link:hover { color: var(--accent); }
	.note-tags { color: var(--muted); font-size: 12px; }
	@media (max-width: 600px) {
		.home-page { grid-template-columns: 1fr; align-content: start; }
		.note-list { padding: 16px 12px; }
		.note-link { flex-wrap: wrap; gap: 6px 16px; }
	}
</style>